<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="godot-nuget" value="./godot-nuget" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <!-- Godot packages must come from the Spine editor, never from nuget.org. -->
  <packageSourceMapping>
    <packageSource key="godot-nuget">
      <package pattern="Godot*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
